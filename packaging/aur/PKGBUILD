# Maintainer: Lucas Bailey <lbailey94@protonmail.com>
# Prebuilt-binary package; the v10 line is glibc-only (ONNX runtime), so the
# gnu assets are used. AUR pkgver cannot contain hyphens, hence the
# underscore in prereleases; the release tag uses the dash form. Bump
# pkgver + both checksums when a new tag ships.
pkgname=whitemagic-bin
pkgver=10.2.0_alpha.4
pkgrel=1
pkgdesc="Local-first memory, recall, and continuity engine for AI agents (prebuilt)"
arch=('x86_64' 'aarch64')
url="https://whitemagic.dev"
license=('MIT')
provides=('whitemagic')
conflicts=('whitemagic')
options=('!strip')
_tag="v${pkgver//_/-}"
source_x86_64=("${pkgname}-${pkgver}-x86_64.gz::https://github.com/lbailey94/whitemagic/releases/download/${_tag}/wm-linux-x86_64.gz")
source_aarch64=("${pkgname}-${pkgver}-aarch64.gz::https://github.com/lbailey94/whitemagic/releases/download/${_tag}/wm-linux-aarch64.gz")
sha256sums_x86_64=('d558c7fa67ee68439c1c2dcc55a68e01dd57206ca9614a382822df2cd64dbbed')
sha256sums_aarch64=('ac749a0bfff2434c165abedc58ce412edb5891ce14449304c087e3a7f27cd0c2')

package() {
  install -d "${pkgdir}/usr/bin"
  gzip -dc "${srcdir}/${pkgname}-${pkgver}-${CARCH}.gz" > "${pkgdir}/usr/bin/wm"
  chmod 755 "${pkgdir}/usr/bin/wm"
}
