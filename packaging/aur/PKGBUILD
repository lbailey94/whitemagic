# Maintainer: Lucas Bailey <lbailey94@protonmail.com>
# Prebuilt-binary package; the v10 line is glibc-only (ONNX runtime), so the
# gnu assets are used. Bump pkgver + both checksums when a stable tag ships.
pkgname=whitemagic-bin
pkgver=9.3.4
pkgrel=1
pkgdesc="Local-first memory, recall, and continuity engine for AI agents (prebuilt)"
arch=('x86_64' 'aarch64')
url="https://whitemagic.dev"
license=('MIT')
provides=('whitemagic')
conflicts=('whitemagic')
options=('!strip')
source_x86_64=("${pkgname}-${pkgver}-x86_64::https://github.com/lbailey94/whitemagic/releases/download/v${pkgver}/wm-linux-x86_64")
source_aarch64=("${pkgname}-${pkgver}-aarch64::https://github.com/lbailey94/whitemagic/releases/download/v${pkgver}/wm-linux-aarch64")
sha256sums_x86_64=('0e7e666552d865c1c2bec9f5761ad449e5fe258d2eff3da65dc3bd85c9af57c5')
sha256sums_aarch64=('d7b889f24aef0ce43c3818f4e7f7044ec007c923abb17b407b8f2cf620f6ee95')

package() {
  install -Dm755 "${srcdir}/${pkgname}-${pkgver}-${CARCH}" "${pkgdir}/usr/bin/wm"
}
