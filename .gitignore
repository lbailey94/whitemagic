# Fuzz build artifacts
/fuzz/target/
/fuzz/artifacts/

# Curated fuzz corpus seeds (named seed_*) are committed so CI bootstraps
# from them; files libFuzzer regenerates (sha1-named) stay ignored.
/fuzz/corpus/*
!/fuzz/corpus/*/
/fuzz/corpus/*/*
!/fuzz/corpus/*/seed_*

# Per-project opencode MCP wiring — machine-specific absolute paths; the
# committed template lives in docs/MULTI_PROJECT_MEMORY.md
/opencode.jsonc

# Memorastrict scale-stress fixtures — derived by `memorastrict_gen.py
# --scale-turns N`; the tracked root seeds are the source of truth.
/benchmarks/data/memorastrict/scale_*/

# Internal estate expedition drills and local test runners
/crates/wm-tools/examples/

